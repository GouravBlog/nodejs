<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css">
</head>

<body>
    <h1>
        <%= message %>
    </h1>

    <table class="table" border="1">
        <thead>
            <tr>
                <th scope="col">First Namw</th>
                <th scope="col">Last Name</th>
                <th scope="col">Email</th>
                <th scope="col">Mobile</th>
                <th scope="col">Address</th>
                <th scope="col">Action</th>
            </tr>
        </thead>
        <tbody>
            <% Con.forEach(function(contact,i){ %>
                <tr>
                    <td>
                        <%= counter++ %>
                    </td>
                    <td scope="row">
                        <a href="/show-contact/<%= contact._id %>">
                            <%= contact.first_name %>
                        </a>
                    </td>
                    <td>
                        <%= contact.last_name %>
                    </td>
                    <td>
                        <%= contact.email %>
                    </td>
                    <td>
                        <%= contact.mobile %>
                    </td>
                    <td>
                        <%= contact.address %>
                    </td>
                    <td>
                        <a href="/update-contact/<%= contact._id %>">Edit</a>
                        <a href="/delete-contact/<%= contact._id %>">Delete</a>
                    </td>
                </tr>
                <% }) %>
        </tbody>
    </table>
    <nav>
        <ul class="pagination justify-content-center">
            <% let disabled1=hasPrevPage ? "" : "disabled" %>
                <li class="page-item <%= disabled1 %>"><a href="?page=<%= prevPage %>" class="page-link">Previous</a>
                </li>

                <% for(var i=1; i <=totalPages; i++ ){ let active=currentPage==i ? "active" : "" %>
                    <li class="page-item <%= active %>">
                        <a class="page-link" href="?page=<%= i %>">
                            <%= i %>
                        </a>
                    </li>
                    <% } %>
                        <% let disabled2=hasNextPage ? "" : "disabled" %>

                            <li class="page-item <%= disabled2 %>"><a class="page-link"
                                    href="?page=<%= nextPage %>">Next</a></li>
        </ul>
    </nav>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>