<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>

<body>

    <div class="container">
        <div class="row">
            <div class="col-md-9">
                <p><b>First Name:</b><span>
                        <%= user.first_name %>
                    </span></p>
                <p><b>Last Name:</b><span>
                        <%= user.last_name %>
                    </span></p>
                <p><b>Email:</b><span>
                        <%= user.email %>
                    </span></p>
                <p><b>Mobile:</b><span>
                        <%= user.mobile %>
                    </span></p>
                <p><b>Address:</b><span>
                        <%= user.address %>
                    </span></p>

            </div>
        </div>
    </div>
</body>

</html>